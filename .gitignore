# macOS
.DS_Store
# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
# Swift Package Manager
.build/
.swiftpm/
Package.resolved
# Secrets — never commit signing material or credentials
*.p12
*.mobileprovision
*.cer
Secrets.xcconfig
# Generated art rasters (source of truth is the SVG)
Art/render/

# Generated illustration assets. Scripts/build-assets.sh copies every drawing in
# Art/ into the catalog Image(_:) reads from; Art/ is the source of truth and
# the three hand-authored entries beside it (AccentColor, AppIcon,
# LaunchBackground) are committed as normal.
HopPotty/Resources/Assets.xcassets/Illustrations/

# Generated Xcode project — HopPotty.xcodeproj is a build artefact produced from
# project.yml by Scripts/bootstrap.sh. Committing it would give the repository
# two sources of truth for the target graph, and the .pbxproj is the one nobody
# can review.
*.xcodeproj
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata

# Web prototype build output and Vercel project link
web/dist/
.vercel/

# React Native / JS
node_modules/
web-preview/dist/
web-preview/.vercel/
.vercel/
