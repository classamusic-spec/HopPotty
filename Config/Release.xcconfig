// HopPotty — Release.
//
// The configuration that is archived, uploaded, and installed by families.

#include "Base.xcconfig"

// ---------------------------------------------------------------------------
// Compilation conditions
// ---------------------------------------------------------------------------
//
// Note what is NOT here: DEBUG, HOPPOTTY_DEBUG_TOOLS, HOPPOTTY_MOCKS.
// Adding any of the three to this file is a release-blocking defect, not a
// convenience. Scripts/verify-config.sh fails if one appears.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)

// ---------------------------------------------------------------------------
// The Potty Pause Lab, and why EXCLUDED_SOURCE_FILE_NAMES is NOT used here
// ---------------------------------------------------------------------------
//
// The Lab can raise a shield over a child's apps, cancel every scheduled
// monitor and wipe the App Group. It must not exist in a build a family can
// install, and it does not: `PottyPauseLab` is inside `#if DEBUG`, and DEBUG is
// defined only by Config/Debug.xcconfig. The type is absent from this binary,
// not merely unreachable in it.
//
// The obvious belt-and-braces addition would be
//
//     EXCLUDED_SOURCE_FILE_NAMES = $(SRCROOT)/HopPotty/Developer/*
//
// and it is deliberately absent, because it would break this build rather than
// harden it. HopPotty/Developer/DeveloperSurface.swift is a *seam*: its
// `developerSurface()` modifier compiles to `self` in the `#else` branch so that
// call sites are written once and compile in both configurations. Excluding the
// directory would delete that `#else` branch too, and every call site would fail
// to compile in Release only — the worst possible place to discover it.
//
// What replaces it is a check rather than a build setting:
// Scripts/verify-config.sh fails if any file under HopPotty/Developer/ is not
// guarded by a compilation condition this configuration does not define, and it
// runs in CI on every push. That covers the case the exclusion was meant to
// cover — a developer-only file someone forgot to wrap — without breaking the
// pattern that makes the guard usable.

// ---------------------------------------------------------------------------
// Build
// ---------------------------------------------------------------------------

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
VALIDATE_PRODUCT = YES
MTL_ENABLE_DEBUG_INFO = NO
MTL_FAST_MATH = YES
COPY_PHASE_STRIP = NO
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = all

// See Debug.xcconfig for why these are NO here.
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO
