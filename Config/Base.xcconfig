// HopPotty — settings shared by every configuration and every target.
//
// This file is the project-level base. Xcode's build setting precedence is:
//
//     target setting  >  target .xcconfig  >  project setting  >  project .xcconfig
//
// project.yml deliberately puts almost nothing at the target level, so what you
// read here is what the compiler gets. Anything a single target must override
// (bundle identifier, entitlements path, Info.plist path) is set in project.yml
// next to the target it belongs to, so a target's identity is readable in one
// place.
//
// Nothing in this directory may contain signing material. Team IDs come from
// Config/Secrets.xcconfig, which is git-ignored — see the bottom of this file.

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// The one string every other bundle identifier is derived from. The three
// extension identifiers are this plus a suffix, which is also Apple's rule: an
// app extension's bundle identifier must be prefixed by its host app's.
//
// PLACEHOLDER. Nobody here owns `com.hoppotty`. Before the first device build,
// replace it with a reverse-DNS prefix your Apple Developer account controls, in
// ONE of two places:
//
//   * Config/Secrets.xcconfig (git-ignored) — for a personal or fork build; or
//   * here — for the project's real, permanent identity.
//
// and in the same commit change the matching literals in
// HopPotty/Services/ScreenTime/ScreenTimeIdentifiers.swift. The values here are
// deliberately identical to those literals; Scripts/verify-config.sh fails if
// the two ever drift apart.
HOPPOTTY_APP_BUNDLE_ID = com.hoppotty

// Suffixes for the three Screen Time extensions. Here rather than inline in
// project.yml so the four identifiers can be read as one set, and so the set can
// be diffed against ScreenTimeIdentifiers.swift by a script.
HOPPOTTY_MONITOR_BUNDLE_ID = $(HOPPOTTY_APP_BUNDLE_ID).monitor
HOPPOTTY_SHIELD_CONFIG_BUNDLE_ID = $(HOPPOTTY_APP_BUNDLE_ID).shieldconfig
HOPPOTTY_SHIELD_ACTION_BUNDLE_ID = $(HOPPOTTY_APP_BUNDLE_ID).shieldaction

// The widget extension. Listed apart from the three above because it is not a
// Screen Time extension: it holds no Family Controls entitlement, links neither
// ManagedSettings nor DeviceActivity, and does not appear in the Family Controls
// distribution request (Docs/Entitlements.md §2, Docs/Widgets.md §5). It is in
// the same App Group, and that is the whole of its privilege.
HOPPOTTY_WIDGETS_BUNDLE_ID = $(HOPPOTTY_APP_BUNDLE_ID).widgets

// The App Group every target must be a member of. LOAD-BEARING: it must equal
// ScreenTimeIdentifiers.appGroupID exactly. A mismatch is silent at build time
// and total at runtime — UserDefaults(suiteName:) returns nil, the container URL
// is unavailable, and the app and its extensions quietly stop seeing each
// other's state while every individual target still builds, signs and runs.
HOPPOTTY_APP_GROUP = group.com.hoppotty

// The one-time "HopPotty Family" unlock. Must match the product identifier in
// HopPotty/Resources/HopPotty.storekit AND the one in App Store Connect.
HOPPOTTY_IAP_FAMILY_PRODUCT_ID = $(HOPPOTTY_APP_BUNDLE_ID).family

// The home-screen name. Overridden in DebugMock.xcconfig so a fake-service
// build is identifiable on the home screen.
HOPPOTTY_DISPLAY_NAME = HopPotty

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ---------------------------------------------------------------------------
// Platform — see Docs/ADR/0002-deployment-target.md
// ---------------------------------------------------------------------------

// 17.0 is bought by SwiftData and Observation, not by Screen Time. It must stay
// equal to `.iOS(.v17)` in HopPottyKit/Package.swift; verify-config.sh checks it.
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// 1 = iPhone, 2 = iPad. Both, per the product brief.
TARGETED_DEVICE_FAMILY = 1,2

// Family Controls authorization fails outright on visionOS
// (ScreenTimeArchitecture.md §11.11), and the Screen Time frameworks do not
// exist on macOS. Shipping either would be shipping a build whose headline
// feature cannot work.
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// ---------------------------------------------------------------------------
// Swift
// ---------------------------------------------------------------------------

// Swift 6 language mode. HopPottyKit already compiles under it on Linux
// (swift-tools-version 6.0), so the app layer inherits an already-audited core.
SWIFT_VERSION = 6.0

// Redundant under the Swift 6 language mode, stated anyway: if anyone ever pins
// SWIFT_VERSION back to 5 to unblock something, the data-race diagnostics stay.
SWIFT_STRICT_CONCURRENCY = complete

SWIFT_EMIT_LOC_STRINGS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// ---------------------------------------------------------------------------
// Opt-in: the shield that can open HopPotty
// ---------------------------------------------------------------------------
//
// Uncomment the line below — and nothing else — to build
// `ShieldActionResponse.openParentalControlsApp` into HopPottyShieldAction, so
// that a child who finishes the routine on the shield lands back in HopPotty
// and sees their star arrive, instead of collecting it the next time the app is
// opened. `Extensions/HopPottyShieldAction/HopPottyShieldActionExtension.swift`
// is the only file that reads it.
//
// It is off because the first real compile said so. The iOS 26.2 SDK in
// Xcode 26.3 does not have that case:
//
//     HopPottyShieldActionExtension.swift:222:21: error: type
//     'ShieldActionResponse' has no member 'openParentalControlsApp'
//
// which is the answer to the "UNVERIFIED — confirm that this case exists under
// this spelling" note that has sat above that line since it was written. It
// does not exist in the SDK this project builds against today, and whether it
// exists under this spelling in a later one is still unverified.
//
// It is a flag rather than a deletion because the behaviour it buys is real and
// the design already accounts for both halves of it: `.close` is the shipping
// path, the reward ledger is append-only and idempotent, and no copy anywhere
// promises the child an immediate star. Turning this on is an improvement, not
// a requirement, which is exactly the shape of thing that belongs behind a flag
// whose default is off.
//
// Before turning it on: build for a device with the SDK that claims the case,
// and confirm on hardware that it opens HopPotty rather than a Settings pane.
//
// HOPPOTTY_SHIELD_CAN_OPEN_APP is deliberately NOT set here by an
// `[sdk=iphoneos26.5*]` condition. That would silently switch behaviour on
// whoever happens to have a newer Xcode, which is how a shield starts
// launching an app in front of a child on one machine and not another.
//
// SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) HOPPOTTY_SHIELD_CAN_OPEN_APP

// ---------------------------------------------------------------------------
// Diagnostics that are on in every configuration
// ---------------------------------------------------------------------------

CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
ENABLE_STRICT_OBJC_MSGSEND = YES
CLANG_ENABLE_OBJC_WEAK = YES
CLANG_ENABLE_MODULES = YES

// We author every Info.plist by hand (see the four Info.plist files in the
// repository) because the NSExtension dictionaries are the part of this project
// most likely to be wrong, and they should be reviewable in a diff.
GENERATE_INFOPLIST_FILE = NO

ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

// ---------------------------------------------------------------------------
// Signing
// ---------------------------------------------------------------------------
//
// Automatic is recommended by Apple for Family Controls specifically: with
// automatic signing Xcode enables the capability on each App ID and, once the
// distribution request is approved, promotes it without further work
// (Docs/Entitlements.md §3).
CODE_SIGN_STYLE = Automatic

// Deliberately empty here. Xcode will say "Signing for <target> requires a
// development team" until you supply one — a loud, obvious failure rather than
// a wrong value baked into a committed file.
HOPPOTTY_DEVELOPMENT_TEAM =

// Local, git-ignored overrides: Team ID and any per-developer bundle prefix.
// `#include?` (note the question mark) does not fail when the file is absent, so
// a fresh clone still generates and builds up to the signing step.
// Scripts/bootstrap.sh creates it from Config/Secrets.example.xcconfig.
#include? "Secrets.xcconfig"

DEVELOPMENT_TEAM = $(HOPPOTTY_DEVELOPMENT_TEAM)
