// HopPotty — local signing configuration. TEMPLATE.
//
// Copy to Config/Secrets.xcconfig (Scripts/bootstrap.sh does this for you) and
// fill in your Team ID. Config/Secrets.xcconfig is git-ignored by the
// `Secrets.xcconfig` rule in .gitignore — keep it that way. It holds an
// identifier, not a credential, but the moment it is tracked someone will add a
// credential to it.
//
// Find your Team ID at https://developer.apple.com/account under Membership
// details, or in Xcode: Settings -> Accounts -> your account -> the team's
// "Team ID" column. Ten characters, e.g. A1B2C3D4E5.

HOPPOTTY_DEVELOPMENT_TEAM = 

// Optional. Uncomment and change if the bundle identifiers below are already
// taken in your account, or if you are building a fork alongside the real app.
// If you change this you MUST also change the matching literals in
// HopPotty/Services/ScreenTime/ScreenTimeIdentifiers.swift, register the new
// App Group in the developer portal, and re-run Scripts/verify-config.sh.
//
// HOPPOTTY_APP_BUNDLE_ID = com.example.hoppotty
// HOPPOTTY_APP_GROUP = group.com.example.hoppotty
