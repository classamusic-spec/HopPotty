<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shield Action extension entitlements.

  Same two capabilities as the app, and for the same reasons:

  * Family Controls — every target that touches ManagedSettings, ManagedSettingsUI
    or DeviceActivity needs it, extensions included, and the distribution request
    must be submitted separately for THIS extension's App ID
    (Docs/Entitlements.md §2: "If your app includes a Screen Time API app
    extension, submit the same request for the extension").

  * App Group — expanded from HOPPOTTY_APP_GROUP in Config/Base.xcconfig. Must be
    byte-identical to the app's and to ScreenTimeIdentifiers.appGroupID; a
    mismatch is invisible until a family's shield fails to clear.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HOPPOTTY_APP_GROUP)</string>
	</array>
</dict>
</plist>
