<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HopPotty (application) entitlements.

  Two capabilities, both required, neither optional:

  * com.apple.developer.family-controls — required before calling
    requestAuthorization(for:). Development use comes with Apple Developer
    Program membership; DISTRIBUTION (TestFlight, Ad Hoc, App Store) requires an
    approval request submitted by the Account Holder for this App ID *and* for
    each of the three extension App IDs. Start that request the day the App IDs
    exist. See Docs/Entitlements.md §2.

  * com.apple.security.application-groups — the app-to-extension channel. The
    value is expanded from HOPPOTTY_APP_GROUP in Config/Base.xcconfig and MUST
    equal ScreenTimeIdentifiers.appGroupID. Scripts/verify-config.sh checks it,
    because the failure mode is silent: UserDefaults(suiteName:) returns nil and
    the container URL is unavailable, so the extensions quietly stop seeing the
    app's state.

  Note: named ManagedSettingsStores are shared between an app and its extensions
  automatically and need no App Group. The App Group carries HopPotty's own
  payloads only (Docs/ScreenTimeArchitecture.md §10).

  NEVER add: aps-environment (no push), iCloud containers, keychain sharing
  groups, or com.apple.developer.family-controls.app-and-website-usage — the
  last is deliberately declined in Docs/Entitlements.md §1.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HOPPOTTY_APP_GROUP)</string>
	</array>
</dict>
</plist>
